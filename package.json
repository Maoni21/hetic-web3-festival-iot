{
  "name": "festival-iot",
  "version": "1.0.0",
  "description": "Système IoT simulé pour la gestion d'accès d'un festival de photographie",
  "type": "module",
  "scripts": {
    "dev": "tsx src/presentation/api/server.ts",
    "simulate": "tsx scripts/run-simulation.ts",
    "simulate:scenario": "tsx scripts/run-simulation.ts --scenario",
    "seed": "tsx scripts/seed.ts",
    "type-check": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "aedes": "^0.51.3",
    "date-fns": "^3.6.0",
    "express": "^4.19.2",
    "mqtt": "^5.10.1",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
